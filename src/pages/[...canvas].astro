---
// A canvas, the core's blank page, at its address, /go/<slug>/ (site-description.json). The frame gives it neither
// header nor footer, so its body, as the design's bands through Konzilo Design's PageBody, with the page's context
// given first, is the whole page.
import Body from '@kntnt/konzilo/astro/Body.astro';
import { entryPages } from '@kntnt/konzilo/astro/languages';
import PageBody from '@kntnt/konzilo-design/page-parts/PageBody.astro';
import { render } from 'astro:content';
import Site from '../layouts/Site.astro';
import { givePageContext } from '../lib/design-page.js';

export function getStaticPaths() {
  return entryPages('canvases', 'canvas');
}

const { entry, page } = Astro.props;
const { Content } = await render(entry);
await givePageContext(Astro, { entry });
---
<Site entry={entry} page={page}>
  <PageBody><Body post={entry} page={page}><Content /></Body></PageBody>
</Site>
