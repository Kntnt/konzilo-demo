---
// A canvas, the core's blank page, at its address, /go/<slug>/ (site-description.json). The frame gives it neither
// header nor footer, so its body, bands drawn by Konzilo Design's components with the page's context given first,
// is the whole page.
import { entryPages } from '@kntnt/konzilo/astro/languages';
import { render } from 'astro:content';
import PageBody from '../components/PageBody.astro';
import Site from '../layouts/Site.astro';
import { givePageContext } from '../lib/design-page.js';

export function getStaticPaths() {
  return entryPages('canvases', 'canvas');
}

const { entry, page } = Astro.props;
const { Content } = await render(entry);
await givePageContext(Astro, { entry });
---
<Site entry={entry} page={page}>
  <PageBody post={entry} page={page}><Content /></PageBody>
</Site>
