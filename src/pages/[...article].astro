---
// An article at its address, /insights/<slug>/ (site-description.json). A plain stand-in for the design's
// article: its main headline, its meta line, by the format the site settings give articles, and its body
// through the core's Body.
import Body from '@kntnt/konzilo/astro/Body.astro';
import { entryPages } from '@kntnt/konzilo/astro/languages';
import { render } from 'astro:content';
import MetaLine from '../components/MetaLine.astro';
import StandIn from '../components/StandIn.astro';
import Site from '../layouts/Site.astro';
import { givePageContext } from '../lib/design-page.js';

export function getStaticPaths() {
  return entryPages('articles', 'article');
}

const { entry, page } = Astro.props;
const { Content } = await render(entry);
await givePageContext(Astro, { entry, title: entry.data.headline });
---
<Site entry={entry} page={page}>
  <StandIn>
    <h1>{entry.data.headline}</h1>
    <MetaLine entry={entry} />
    <Body post={entry} page={page}><Content /></Body>
  </StandIn>
</Site>
