---
// A page at its address, /<path>/: the slugs of its parents and its own (site-description.json), as Konzilo Design's
// docs/spec/konzilo.md (The templates, A page) places it: its body as the design's bands through the package's
// PageBody, which puts a run of loose blocks in a section of its own and the title band first where the body opens with
// no hero, the page's context given first (src/lib/design-page.js). Each post list stands in the presentation it
// names, and each form in the site's form. On the page the site settings choose as the cookie policy, the core's cookie
// declaration follows the body in a section of its own. A page whose post list has pages of its own has them at
// <address>page/2/ and on.
import Body from '@kntnt/konzilo/astro/Body.astro';
import { entryPages } from '@kntnt/konzilo/astro/languages';
import PageBody from '@kntnt/konzilo-design/page-parts/PageBody.astro';
import { render } from 'astro:content';
import CookiePolicyDeclaration from '../components/CookiePolicyDeclaration.astro';
import Site from '../layouts/Site.astro';
import { givePageContext } from '../lib/design-page.js';

export function getStaticPaths() {
  return entryPages('pages', 'page');
}

const { entry, page } = Astro.props;
const { Content } = await render(entry);
await givePageContext(Astro, { entry });
---
<Site entry={entry} page={page}>
  <PageBody>
    <Body post={entry} page={page}><Content /></Body>
    <CookiePolicyDeclaration entry={entry} />
  </PageBody>
</Site>
