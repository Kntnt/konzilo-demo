---
// The 404 page, which Astro builds as 404.html and the web server shows at every address the site has nothing at, as
// Konzilo Design's docs/spec/konzilo.md (The templates, The 404 page) places it: the page an Admin chose in the site
// settings, its body as the design's bands through PageBody, its title the hero's H1 or the title band's, with no
// trail, since it stands at no address of its own; or, where none is chosen or it cannot serve, the core's own words
// under the title band.
import Body from '@kntnt/konzilo/astro/Body.astro';
import { pageLanguage, pageTexts, startPage } from '@kntnt/konzilo/astro/languages';
import { notFoundPage } from '@kntnt/konzilo/astro/site-settings';
import PageBody from '@kntnt/konzilo-design/page-parts/PageBody.astro';
import { render } from 'astro:content';
import Site from '../layouts/Site.astro';
import { givePageContext } from '../lib/design-page.js';

const plain = pageTexts(Astro.url).notFound;
const page = await notFoundPage(Astro.url);
const Content = page ? (await render(page)).Content : null;
const heading = page?.data.title ?? plain.title;
await givePageContext(Astro, { title: heading });
---
<Site title={heading}>
  <PageBody>
    {Content ? <Body post={page}><Content /></Body> : <><p>{plain.text}</p><p><a href={startPage(pageLanguage(Astro.url))}>{plain.start}</a></p></>}
  </PageBody>
</Site>
