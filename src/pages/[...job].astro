---
// A vacancy, the site's own type `job`, at its address, /about/careers/<slug>/ (site-description.json), made like an
// article as Konzilo Design's docs/spec/konzilo.md (The templates, A type with no picture) places it and the mockups
// have it (design/mockups/src/lib/types.js):
//
// - its opening on tint, with its excerpt as its deck and, under it, its facts, a Value List of the type's fields
//   (src/lib/facts.js), and one main action to the body's crosshead on how to apply;
// - its body with its following menu;
// - "Other vacancies", the others by their last day to apply, soonest first, in the site's own `rows` presentation,
//   and a link to the section of the careers page that lists them.
//
// The Value List, the actions and the band of other vacancies are Konzilo Design's page parts, ValueList, Actions and
// Section. Every word the template shows that no post holds, the action, the menu's label, "Other vacancies" and its
// link, is a setting of the site's own; the action leads to the crosshead in its words, by the id the core gives a
// crosshead, its words in lower case joined by hyphens.
import Body from '@kntnt/konzilo/astro/Body.astro';
import { entryPages } from '@kntnt/konzilo/astro/languages';
import { listedPosts } from '@kntnt/konzilo/astro/post-lists';
import { siteSettings } from '@kntnt/konzilo/astro/site-settings';
import Actions from '@kntnt/konzilo-design/page-parts/Actions.astro';
import ArticleBody from '@kntnt/konzilo-design/page-parts/ArticleBody.astro';
import ArticleOpening from '@kntnt/konzilo-design/page-parts/ArticleOpening.astro';
import Section from '@kntnt/konzilo-design/page-parts/Section.astro';
import ValueList from '@kntnt/konzilo-design/page-parts/ValueList.astro';
import { render } from 'astro:content';
import Rows from '../components/Rows.astro';
import Site from '../layouts/Site.astro';
import { givePageContext } from '../lib/design-page.js';
import { factsOf } from '../lib/facts.js';

export function getStaticPaths() {
  return entryPages('jobs', 'job');
}

const { entry, page } = Astro.props;
const { Content } = await render(entry);
await givePageContext(Astro, { entry, title: entry.data.title });
const settings = (await siteSettings(Astro.url)) ?? {};

// The opening takes the excerpt as its deck, where an article has its standfirst.
const opening = { ...entry, data: { ...entry.data, standfirst: entry.data.excerpt } };
const facts = factsOf(entry, 'job', ['location', 'team', 'employment', 'closingDate'], Astro.url);
const crosshead = (words) => String(words).toLowerCase().replace(/[^\p{L}\p{N}\s-]/gu, '').trim().replace(/\s+/g, '-');
const apply = settings.vacancyApplyLabel ? [{ label: settings.vacancyApplyLabel, href: `#${crosshead(settings.vacancyApplyLabel)}` }] : [];

const others = await listedPosts({ type: 'job', order: 'closingDate', direction: 'ascending', number: 10 }, { post: entry });
const all = settings.vacancyAllPage ? `${settings.vacancyAllPage.url}${settings.vacancyAllAnchor ? `#${settings.vacancyAllAnchor}` : ''}` : undefined;
---
<Site entry={entry} page={page}>
  <ArticleOpening entry={opening} surface="tint">
    <Fragment slot="after"><ValueList items={facts} /><Actions links={apply} /></Fragment>
  </ArticleOpening>
  <ArticleBody label={settings.vacancyMenuLabel}><Body post={entry} page={page}><Content /></Body></ArticleBody>
  {others.length > 0 && (
    <Section surface="raised" heading={settings.vacancyOthersHeading}>
      <Rows posts={others} />
      <Actions links={[{ label: settings.vacancyAllLabel, href: all }]} />
    </Section>
  )}
</Site>
