---
// A term's page, which the core's integration puts at the address of each taxonomy that declares one
// (site-description.json): an author at /insights/author/<slug>/, a category at /insights/category/<path>/, a topic at
// /insights/topic/<slug>/, as Konzilo Design's docs/spec/konzilo.md (The templates, A term's page) places it and the
// approved design had it:
//
// - the term's opening on tint, the package's TermOpening: the trail, the taxonomy's word as its eyebrow, the term's
//   name as the H1 and its description as the deck;
// - its posts of every type that takes the taxonomy, newest first, nine a page as the design has them, with the later
//   pages at <address>page/2/ and on, in the design's `filtered` presentation, which the page calls itself with what
//   the core's termPages() gives it: the whole list, `list`, which the count and the pills are of, and the term it
//   settles, `settled`, so that the row of that taxonomy goes and a search keeps to the term: a category's page has the
//   rows Topic and Search, a topic's Category and Search, and an author's all three (design/feedback.md, point 21);
// - and the newsletter band Insights ends with, Konzilo Design's page part Section with the site's form and the
//   package's SmallPrint in its body, its words the site's settings.
import { termPages } from '@kntnt/konzilo/astro/post-lists';
import { siteSettings } from '@kntnt/konzilo/astro/site-settings';
import PageBody from '@kntnt/konzilo-design/page-parts/PageBody.astro';
import Section from '@kntnt/konzilo-design/page-parts/Section.astro';
import SmallPrint from '@kntnt/konzilo-design/page-parts/SmallPrint.astro';
import TermOpening from '@kntnt/konzilo-design/page-parts/TermOpening.astro';
import Filtered from '@kntnt/konzilo-design/presentations/Filtered.astro';
import Form from './Form.astro';
import Site from '../layouts/Site.astro';
import { givePageContext } from '../lib/design-page.js';
import { settingHtml } from '../lib/setting-text.js';

export async function getStaticPaths({ routePattern }) {
  return termPages(routePattern, { number: 9 });
}

// The form the newsletter band holds.
const NEWSLETTER = 'newsletter';

const { term, page, posts, pager, empty, list, settled } = Astro.props;
await givePageContext(Astro, { entry: term, title: term.data.name });
const settings = (await siteSettings(Astro.url)) ?? {};
---
<Site entry={term} page={page}>
  <TermOpening term={term} surface="tint" />
  <PageBody title={false}>
    <Filtered posts={posts} pager={pager} empty={empty} list={list} options={{ filters: 'category topics search' }} settled={settled} />
  </PageBody>
  {settings.termNewsletterHeading && (
    <Section surface="tint" anchor="newsletter" heading={settings.termNewsletterHeading} deck={settings.termNewsletterText}>
      <Form name={NEWSLETTER} />
      {settings.termNewsletterNote && <SmallPrint><Fragment set:html={settingHtml(settings.termNewsletterNote)} /></SmallPrint>}
    </Section>
  )}
</Site>
