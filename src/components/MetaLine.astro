---
// A post's meta line, written by the format an Admin sets for its type, by the core's metaLine(): each author
// and the category linked to its page, and each date a <time>. Nothing where the type has no format. A plain
// stand-in: the design writes the byline, the date and the category with classes of its own.
import { metaLine } from '@kntnt/konzilo/astro/helpers';

const { entry } = Astro.props;
const line = await metaLine(entry, Astro.url);
---
{line.length > 0 && <p>{line.map(({ text, url, datetime }) => (url ? <a href={url}>{text}</a> : datetime ? <time datetime={datetime}>{text}</time> : text))}</p>}
