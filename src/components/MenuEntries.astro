---
// A menu's entries, each with the entries under it, as a plain list: part of the stand-in frame. An entry
// without an address only holds others. An address on the site starts at the site's base, so that it stays
// in a preview, which is served below a base of its own.
const { items } = Astro.props;
const based = (url) => (url.startsWith('/') && !url.startsWith('//') ? `${import.meta.env.BASE_URL}${url.slice(1)}` : url);
---
<ul>
  {items.map((item) => (
    <li>
      {item.url ? <a href={based(item.url)}>{item.title}</a> : <span>{item.title}</span>}
      {item.items?.length > 0 && <Astro.self items={item.items} />}
    </li>
  ))}
</ul>
