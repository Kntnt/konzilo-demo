---
// What a template shows, as a plain stand-in until the template's own design takes its place: in a Band of the page's
// Surface, in the library's body text at the narrow width, as Konzilo Design's docs/spec/konzilo.md shows a template
// placing a post's body. Every route and the term and search pages use it.
import Band from '@kntnt/konzilo-design/components/Band.astro';
import BodyText from '@kntnt/konzilo-design/components/BodyText.astro';
---
<Band>
  <BodyText data-kn-width="narrow"><slot /></BodyText>
</Band>
