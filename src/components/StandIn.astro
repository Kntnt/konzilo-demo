---
// What a template shows, as a plain stand-in until Konzilo Design's page parts for templates give its opening and frame:
// in a Band of the page's Surface, in the library's body text at the narrow width, as its docs/spec/konzilo.md shows a
// template placing a body without directives. The article, the case study, the vacancy, a term's opening, the search
// page and the 404 page's plain text use it; a page's, the canvas's and the start page's bodies are bands of their own.
import Band from '@kntnt/konzilo-design/components/Band.astro';
import BodyText from '@kntnt/konzilo-design/components/BodyText.astro';
---
<Band>
  <BodyText data-kn-width="narrow"><slot /></BodyText>
</Band>
