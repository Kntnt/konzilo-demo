---
// The core's cookie declaration on the page the site settings choose as the cookie policy, and nothing on any other
// page: in a Reading Area at the start, as the mockup places it (design/mockups/pages/cookie-policy.astro), which the
// page's PageBody puts in a section of its own after the body. After it, where the site settings give one, the note
// design/content/README.md asks for ("What the legal pages assume"), a link written in it as Markdown drawn as a link,
// and an e-mail address standing alone linked to it, as GFM links one in body text and the mockup has it.
import CookieDeclaration from '@kntnt/konzilo/astro/CookieDeclaration.astro';
import { entryUrl } from '@kntnt/konzilo/astro/languages';
import { siteSettings } from '@kntnt/konzilo/astro/site-settings';
import ReadingArea from '@kntnt/konzilo-design/components/ReadingArea.astro';
import { settingHtml } from '../lib/setting-text.js';

const { entry } = Astro.props;
const settings = (await siteSettings(Astro.url)) ?? {};
const chosen = settings.legalPages?.cookiePolicy?.url;
const here = chosen !== undefined && chosen === entryUrl(entry);
const note = settings.cookieDeclarationNote ? settingHtml(settings.cookieDeclarationNote, { addresses: true }) : null;
---
{here && (
  <ReadingArea side="start">
    <CookieDeclaration />
    {note && <p set:html={note} />}
  </ReadingArea>
)}
