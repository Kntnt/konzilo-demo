---
// Every page's frame: Konzilo Design's Page, Header and Footer, as its docs/spec/konzilo.md shows a Konzilo site's
// layout, with what the core writes on every page placed in them: its head (Head), its consent banner, first in the
// body, and its consent controls, in the footer's lower B2. The header holds the logo and slogan, the search, the menu
// button with the megamenu, and the call to action; the footer the brand, the social links, the words about the
// company, the menu's top level, the address, the note, the legal pages and the consent controls. Their props come
// from src/lib/frame.js. A canvas, the core's blank page, has neither header nor footer.
//
// Page holds the page's one <main>, so a template writes none.
import design from '../../design/site.design.json';
import description from '../../site-description.json';
import { publicSite } from '@kntnt/konzilo/astro';
import ConsentBanner from '@kntnt/konzilo/astro/ConsentBanner.astro';
import ConsentControls from '@kntnt/konzilo/astro/ConsentControls.astro';
import Head from '@kntnt/konzilo/astro/Head.astro';
import { builtInType, legalPages } from '@kntnt/konzilo/astro/helpers';
import { pageTexts, startPage } from '@kntnt/konzilo/astro/languages';
import { siteMenu, siteSettings } from '@kntnt/konzilo/astro/site-settings';
import Footer from '@kntnt/konzilo-design/components/Footer.astro';
import Header from '@kntnt/konzilo-design/components/Header.astro';
import Page from '@kntnt/konzilo-design/components/Page.astro';
import '@kntnt/konzilo-design/components.css';
import { frameProps } from '../lib/frame.js';

const { entry, title, page } = Astro.props;
const framed = builtInType(entry) !== 'canvas';
const settings = (await siteSettings(Astro.url)) ?? {};
const menus = {
  main: (await siteMenu('main', Astro.url)) ?? [],
  social: (await siteMenu('social', Astro.url)) ?? [],
  search: (await siteMenu('search', Astro.url)) ?? [],
};
const frame = frameProps({
  design,
  settings,
  menus,
  legal: legalPages(settings),
  current: Astro.url.pathname,
  base: import.meta.env.BASE_URL,
  home: startPage(),
  search: { address: description.search.address, label: pageTexts(Astro.url).search.label },
});
---
<html lang={publicSite(Astro.url).languageTag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Head entry={entry} title={title} page={page} />
  </head>
  <body>
    <ConsentBanner />
    <Page {...frame.page}>
      {framed && <Header {...frame.header} slot="header" />}
      <slot />
      {framed && (
        <Footer {...frame.footer} slot="footer">
          <ConsentControls slot="lower-b2" links={false} />
        </Footer>
      )}
    </Page>
  </body>
</html>
