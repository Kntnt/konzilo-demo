---
// The frame of a page with the site's header and footer, wired as Konzilo Design's docs/spec/konzilo.md shows a
// Konzilo site's layout: Page, Header and Footer from the package, their props from the design by design-props, and the
// core's consent controls in the footer's lower-b2 slot. `address` is the page's address on the site, which marks the
// menu's current entry; `title` is the window's title. Light, unless `mode` says dark.
import Page from '@kntnt/konzilo-design/components/Page.astro';
import Header from '@kntnt/konzilo-design/components/Header.astro';
import Footer from '@kntnt/konzilo-design/components/Footer.astro';
import { CONSENT_BUTTONS, PAGE_PROPS, footerFor, headerFor } from '../lib/site.js';
import 'virtual:mockup-styles';
import '@kntnt/konzilo-design/components.css';
import '../mockup.css';

interface Props { title: string; address?: string; mode?: 'light' | 'dark' }
const { title, address = '/', mode } = Astro.props;
---
<!doctype html>
<html lang="en-GB" data-kn-mode={mode}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Ampfield Energy</title>
    <slot name="head" />
  </head>
  <body>
    <Page {...PAGE_PROPS}>
      <Header {...headerFor(address)} slot="header" />
      <slot />
      <Footer {...footerFor(address)} slot="footer">
        <Fragment slot="lower-b2" set:html={CONSENT_BUTTONS} />
      </Footer>
    </Page>
    <slot name="after" />
  </body>
</html>
