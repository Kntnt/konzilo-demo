---
// The search page, which the core places at /search/ (Konzilo's SearchPage.astro and Search.astro): the page's title as
// its H1 under the trail, and the core's search with the example query of design/content/system/search.md and its
// results, as the core's script shows them, in the reading column. konzilo.css draws the core's markup.
import Site from '../src/layouts/Site.astro';
import { design } from '../src/lib/design.js';
import { tag } from '../src/lib/html.js';
import { breadcrumbs, context } from '../src/lib/render.js';
import { searchMarkup, TEXTS } from '../src/lib/search.js';
import { trailFor } from '../src/lib/site.js';

const address = '/search/';
const ctx = context({ design, title: TEXTS.title, address, trail: trailFor(address, TEXTS.title) });
// The order system/search.md gives the example query's first results.
const first = ['/solutions/battery-storage/', '/faq/', '/industries/manufacturing/', '/solutions/', '/customers/brantevik-foods/', '/insights/what-fire-safety-a-battery-needs/', '/insights/ampfield-pilot-now-steers-the-loads-that-can-wait/', '/solutions/fleet-charging/'];
const html = tag('section', { class: 'kn-band kn-section' }, tag('div', { class: 'kn-band-content' },
  tag('header', { class: 'kn-section-head' }, breadcrumbs(ctx),
    tag('hgroup', { class: 'kn-heading-group' }, tag('h1', { class: 'kn-heading-group-heading', 'data-kn-type': 'heading-1' }, TEXTS.title))),
  tag('div', { class: 'kn-section-body kn-body-text' },
    tag('div', { class: 'kn-reading-area', 'data-kn-side': 'end', 'data-kn-stack': 'before' },
      tag('div', { class: 'kn-reading-area-flow' }, searchMarkup('battery', { first }))))));
---
<Site title={TEXTS.title} address={address}>
  <Fragment set:html={html} />
</Site>
