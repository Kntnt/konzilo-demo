---
// The header with its menu open, as a click on the menu button opens it, over the start of the home page: a frame of the catalogue, and a page to screenshot the state by.
import Site from '../src/layouts/Site.astro';
import Markdown from '../src/components/Markdown.astro';
import { postByAddress } from '../src/lib/content.js';
const home = postByAddress('/');
---
<Site title="The header, menu" address="/">
  <Markdown file={home.file} title={home.data.title} address="/" />
  <script is:inline slot="after">document.querySelector('.kn-header .kn-megamenu')?.showModal(); document.activeElement?.blur();</script>
</Site>
