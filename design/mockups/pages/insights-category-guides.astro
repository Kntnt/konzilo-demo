---
// The term page of categories/guides, by the site's term page template (src/lib/terms.js).
import Site from '../src/layouts/Site.astro';
import { termPage } from '../src/lib/terms.js';

const { title, address, html } = termPage('categories', 'guides');
---
<Site title={title} address={address}>
  <Fragment set:html={html} />
</Site>
