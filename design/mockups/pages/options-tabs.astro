---
// Options for Thomas's point 15 (design/feedback.md), for him to choose from. Not a page of the site. On Rooftop solar,
// under the tabs of "Two ways to pay", the tab row's rule stands right above the rules of the value list's first row.
// The section is the site's own, read from design/content/pages/solutions/rooftop-solar.md, and drawn once for each
// option under a plain label, first with the first tab open, as the site opens it, and then with the second.
//
// This page alone carries CSS of its own, since it explores a change to the design system's tabs: each option's rules
// are scoped by `data-option` on its sections, and unlayered, so they win over the package's layers.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Site from '../src/layouts/Site.astro';
import { design } from '../src/lib/design.js';
import { CONTENT } from '../src/lib/paths.js';
import { context, renderMarkdown } from '../src/lib/render.js';
import { EMAIL, FORMS } from '../src/lib/site.js';
import { escapeText } from '../src/lib/html.js';

const md = String.raw;
const page = readFileSync(join(CONTENT, 'pages/solutions/rooftop-solar.md'), 'utf8');
const start = page.indexOf(':::::section\n\n## Two ways to pay');
const end = page.indexOf('\n:::::\n', start) + '\n:::::\n'.length;
if (start < 0 || end <= start) throw new Error('options-tabs: "Two ways to pay" is not where it was in rooftop-solar.md');
const source = page.slice(start, end);

const ids = {};
const ctx = () => Object.assign(context({ design, title: undefined, address: '/solutions/rooftop-solar/', forms: FORMS, email: EMAIL }), { ids });
const raised = design.resolved.surfaces.raised;

// The section with one tab open, as the option draws it: `open` is the tab's place, from 1. Its heading keeps no id,
// which would be the same ten times.
function drawn(option, open) {
  let html = renderMarkdown(source, ctx()).replace(/\sid="two-ways-to-pay"/g, '');
  let tab = 0;
  html = html.replace(/<details class="kn-tabs-item" name="([^"]+)"( open)?>/g, (_, name) => `<details class="kn-tabs-item" name="${name}"${++tab === open ? ' open' : ''}>`);
  return html.replace('<section class="kn-band kn-section"', `<section data-option="${option}" data-open="${open}" class="kn-band kn-section"`);
}

const OPTIONS = [
  { key: 'a', name: 'A', title: 'As it is', text: "The tab row has a rule across the whole width under the tabs, and each value in the panel stands under a rule of its own. Where the values stand beside the text, the rules of their first row run about 20 px under the tab row's." },
  { key: 'b', name: 'B', title: "The values' first rule goes", text: "Where a value would stand right under the tab row's rule, it has no rule of its own: the tab row's rule is its rule, and its label stands level with the first line of the text beside it. A value further down, or under the text where the window is narrow, keeps its rule." },
  { key: 'c', name: 'C', title: "The tab row's rule ends with the tabs", text: 'The rule under the tabs is only as long as the row of tabs, and the panel has none. The values keep their rules, which no longer have another above them.' },
  { key: 'd', name: 'D', title: "The tab row's rule above the tabs", text: "The rule across the whole width stands above the tabs, and the open tab is marked on it, so that a tab is drawn as the values under it are: a rule, a label, the content. The two rules are a whole row of tabs apart, and the rule still says that everything under it belongs to the tabs. The orchestrator's proposal." },
  { key: 'e', name: 'E', title: 'The panel on a plate', text: "The open tab and its panel share one plate, as a folder's tab belongs to its folder, and no rule marks the tab row: the plate's edge does. The values keep their rules inside the plate, where nothing but the plate's padding stands above them." },
];

const label = (option, open) => `<header class="option-label"${open === 1 ? '' : ' data-second'}><p class="option-name">${open === 1 ? `Option ${option.name}` : `Option ${option.name}, the second tab open`}</p>${open === 1 ? `<h2 class="option-title">${escapeText(option.title)}</h2><p class="option-text">${escapeText(option.text)}</p>` : ''}</header>`;

const intro = renderMarkdown(md`:::section

Point 15 of design/feedback.md, not a page of the site. Under the tabs of "Two ways to pay" on Rooftop solar, the tab row's rule and the rule over the first row of values stand one above the other. Here is that section with its own text, once for each of five ways out, each first as the page opens it and then with "Buy the power" open. Look at each at a phone's width too.

:::`, Object.assign(context({ design, title: 'Five ways to part the tabs from their values', address: '/options-tabs/', forms: FORMS, email: EMAIL }), { ids }));

const body = OPTIONS.map((option) => [1, 2].map((open) => `<div class="option-label-band">${label(option, open)}</div>${drawn(option.key, open)}`).join('\n')).join('\n');

const css = `
/* The labels: plain, a narrow band each, outside the design's components. */
.option-label-band { background: #1d1d1d; color: #fff; }
.option-label { box-sizing: border-box; inline-size: var(--kn-layout-content-area); margin-inline: auto; padding-block: 1rem; font: 0.9375rem/1.45 system-ui, sans-serif; }
.option-label[data-second] { padding-block: 0.5rem; }
.option-name { margin: 0; font-weight: 700; letter-spacing: 0.02em; }
.option-title { margin: 0.15rem 0 0.25rem; font: 600 1.25rem/1.3 system-ui, sans-serif; }
.option-text { margin: 0; max-inline-size: 48rem; color: #d8d8d8; }

/* B: where the text and the values stand side by side, the values of the first row take the tab row's rule as theirs. */
[data-option="b"] .kn-tabs-panel { container: option-panel / inline-size; }
[data-option="b"] .kn-tabs-parts { container: option-parts / inline-size; }
@container option-panel (min-width: 39rem) {
  [data-option="b"] .kn-tabs-parts > .kn-value-list:first-child > .kn-value-list-item:first-child { border-block-start: 0; padding-block-start: 0; }
  @container option-parts (min-width: 29.5rem) {
    [data-option="b"] .kn-tabs-parts > .kn-value-list:first-child > .kn-value-list-item:nth-child(2) { border-block-start: 0; padding-block-start: 0; }
  }
}

/* C: the rule under the tabs is as long as the row of tabs; the panel has none. */
[data-option="c"] .kn-tabs { column-gap: 0; }
[data-option="c"] .kn-tabs-tab { background-image: linear-gradient(var(--kn-border), var(--kn-border)); background-size: 100% 1px; background-position: bottom; background-repeat: no-repeat; border-radius: 0; }
[data-option="c"] .kn-tabs-panel { border-block-start: 0; }

/* D: the rule across the width above the tabs, the open tab marked on it, and none under the tabs. */
[data-option="d"] .kn-tabs::before { content: ''; flex-basis: 100%; block-size: 0; border-block-start: 1px solid var(--kn-border); }
[data-option="d"] .kn-tabs-label { order: -1; }
[data-option="d"] .kn-tabs-tab { border-block-end: 0; border-block-start: 0.1875rem solid transparent; margin-block-start: -2px; border-radius: 0; }
[data-option="d"] .kn-tabs-item[open] > .kn-tabs-tab { border-block-start-color: var(--kn-accent); }
[data-option="d"] .kn-tabs-panel { border-block-start: 0; padding-block-start: calc(var(--kn-space-component-gap) / 2); }

/* E: the open tab and its panel on one plate, the raised Surface's fill; no rule. */
[data-option="e"] .kn-tabs { --option-plate: ${raised.light.roles.background}; }
[data-kn-mode="dark"] [data-option="e"] .kn-tabs { --option-plate: ${raised.dark.roles.background}; }
[data-option="e"] .kn-tabs-tab { border-block-end: 0; border-end-start-radius: 0; border-end-end-radius: 0; }
[data-option="e"] .kn-tabs-item[open] > .kn-tabs-tab { background: var(--option-plate); }
[data-option="e"] .kn-tabs-panel { border-block-start: 0; padding: var(--kn-space-plate); background: var(--option-plate); border-radius: 0 var(--kn-radius-card) var(--kn-radius-card) var(--kn-radius-card); }
[data-option="e"] .kn-tabs-item:not(:first-of-type)[open] ~ * .kn-tabs-panel, [data-option="e"] .kn-tabs-item:not(:first-of-type)[open] .kn-tabs-panel { border-start-start-radius: var(--kn-radius-card); }
`;
---
<Site title="Five ways to part the tabs from their values" address="/options-tabs/">
  <style slot="head" is:inline set:html={css} />
  <Fragment set:html={intro} />
  <Fragment set:html={body} />
</Site>
