---
// An index of the mockups, for a person who opens dist/index.html from the file system to look through the design. It is
// not a page of the site. It lists every built page, in the order and grouping of the table in design/README.md, says
// which pages are designed and which follow another's design, and links the phone-width screenshots in ../shots/. Its
// links are relative file names, so that they work from the file system. It is drawn with the design's own renderers on
// a canvas, with no header and footer.
import Canvas from '../src/layouts/Canvas.astro';
import Markdown from '../src/components/Markdown.astro';
import { posts } from '../src/lib/content.js';

const title = 'The Ampfield mockups';
const page = (name) => `${name}.html`;
const shot = (file) => `../shots/${file}`;
const designed = 'Designed.';
const phone = (name) => `Designed, also at phone width: [the page at 390 px](${shot(`${name}-390.png`)}).`;
const follows = (label) => `Follows ${label}.`;

// One item of a description list: the page as a link, and what it is.
const item = (label, name, what) => `- [${label}](${page(name)})\n  - ${what}`;
const list = (items) => `:::list{type="description"}\n\n${items.join('\n')}\n\n:::`;
const band = (heading, items, surface) => `::::section${surface ? `{surface="${surface}"}` : ''}\n\n## ${heading}\n\n${list(items)}\n\n::::`;

// The posts of a type, newest first, as the lists of the site show them.
const time = (post) => new Date(post.data.date).getTime();
const ofType = (type) => posts().filter((post) => post.type === type).sort((a, b) => time(b) - time(a));
const showpiece = 'insights-can-your-roof-carry-solar-panels';
const articles = ofType('article').map((post) => item(
  post.data.title,
  post.name,
  post.name === showpiece ? `The showpiece. ${phone(post.name)}` : `${follows('the showpiece, Can your roof carry solar panels?')}${time(post) > Date.parse('2026-11-13T00:00:00Z') ? ' Scheduled for 1 December 2026, so no list shows it yet.' : ''}`,
));
const norrvik = 'customers-norrvik-logistics';
const cases = ofType('case-study').map((post) => item(post.data.title, post.name, post.name === norrvik ? designed : follows('Norrvik Logistics')));
const vacancy = 'about-careers-electrical-design-engineer-gothenburg';
const jobs = ofType('job').map((post) => item(`${post.data.title}, ${post.data.location}`, post.name, post.name === vacancy ? designed : follows('Electrical Design Engineer')));

const md = [
  `Every page of the demo site as a static mockup, drawn from the text in design/content with Konzilo Design's own components, in the order of the table in design/README.md. A page marked designed was laid out on its own; a page that follows another uses that page's composition with its own text. The screenshots at 1440 px of every designed page are in the folder shots, beside this one.`,
  band('Home', [item('Home', 'home', phone('home'))]),
  band('Solutions', [
    item('Solutions', 'solutions', designed),
    item('Rooftop solar', 'solutions-rooftop-solar', phone('solutions-rooftop-solar')),
    item('Battery storage', 'solutions-battery-storage', follows('Rooftop solar')),
    item('Fleet charging', 'solutions-fleet-charging', follows('Rooftop solar')),
    item('Ampfield Pilot', 'solutions-ampfield-pilot', follows('Rooftop solar')),
  ], 'raised'),
  band('Industries', [
    item('Industries', 'industries', follows('Solutions')),
    item('Logistics and warehousing', 'industries-logistics', designed),
    item('Manufacturing', 'industries-manufacturing', follows('Logistics and warehousing')),
    item('Retail and commercial property', 'industries-retail', follows('Logistics and warehousing')),
  ]),
  band('Customers', [item('Customers', 'customers', `${designed} Not in the menu: the industry pages and the case studies' trails lead here.`), ...cases], 'raised'),
  band('Insights', [
    item('Insights', 'insights', designed),
    ...articles,
    item('The category Guides', 'insights-category-guides', `${designed} A topic's page is drawn the same way; none is built.`),
    item('The author Priya Raman', 'insights-author-priya-raman', designed),
  ]),
  band('About', [
    item('About us', 'about', designed),
    item('Team', 'about-team', designed),
    item('Careers', 'about-careers', designed),
    ...jobs,
  ], 'raised'),
  band('Contact, questions and the legal pages', [
    item('Contact', 'contact', phone('contact')),
    item('Questions and answers', 'faq', designed),
    item('Privacy policy', 'privacy-policy', designed),
    item('Cookie policy', 'cookie-policy', follows('Privacy policy')),
    item('Accessibility statement', 'accessibility', follows('Privacy policy')),
  ]),
  band('Search, page not found and the landing page', [
    item('Search results', 'search', designed),
    item('Page not found', 'not-found', designed),
    item('Book a site assessment', 'go-site-assessment', 'Designed. A canvas, with no header and footer.'),
  ], 'raised'),
  band('The header and the footer', [
    `- The menu open\n  - Designed. Screenshots of the window: [at 1440 px](${shot('home-1440-menu.png')}) and [at 390 px](${shot('home-390-menu.png')}).`,
    `- The search box open\n  - Designed. Screenshots of the window: [at 1440 px](${shot('home-1440-search.png')}) and [at 390 px](${shot('home-390-search.png')}).`,
    `- Over a scrolled page\n  - The header slides away as the page scrolls down and comes back, translucent, on the way up. Screenshots of the window: [at 1440 px](${shot('home-1440-scrolled.png')}) and [at 390 px](${shot('home-390-scrolled.png')}).`,
    `- The footer at the page's end\n  - The footer lies still at the window's bottom edge, and the page, casting its shadow on it, reveals it as it scrolls off. Screenshots of the window scrolled to the end of Home: [at 1440 px](${shot('home-1440-end.png')}) and [at 390 px](${shot('home-390-end.png')}).`,
  ]),
  band('The design system', [
    item('The catalogue', 'catalogue', 'Every renderer once, with the Markdown that gives it.'),
    item('The header, closed', 'catalogue-header-closed', 'A frame of the catalogue.'),
    item('The header with its menu open', 'catalogue-header-menu', 'A frame of the catalogue.'),
    item('The header with its search box open', 'catalogue-header-search', 'A frame of the catalogue.'),
  ], 'raised'),
].join('\n\n');
---
<Canvas title={title}>
  <Markdown source={md} title={title} />
</Canvas>
