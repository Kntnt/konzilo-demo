const md = String.raw;
const trail = (...labels) => [...labels.slice(0, -1).map(([label, href]) => ({ label, href })), { label: labels.at(-1) }];

// An article laid out by its fields: a real article's fields, with a shorter body.
const article = posts().find((post) => post.slug === 'can-your-roof-carry-solar-panels') ?? posts().find((post) => post.type === 'article');
const sample = article && {
  ...article,
  body: md`A solar system on a flat roof adds 12 to 20 kg per m², about the weight of five centimetres of wet snow. Most roofs built for a northern winter have room for that. Some do not, and the drawings seldom tell you which.

## <a id="what-the-panels-weigh"></a>What the panels weigh

The weight depends mostly on how the system is held down. On a membrane roof we prefer not to drill: the system rests on the roof and is held against the wind by concrete ballast.

**What did the surveys find?**

That four roofs in five could take an east–west system as they were. The fifth needed a lighter system, a smaller area or work on the roof first.

:::aside{anchor="in-short"}

::eyebrow[In short]

### What a roof survey checks

- The load the roof can still carry
- The age and state of the membrane
- Fire compartments and access for the fire service

:::

## <a id="what-it-costs-to-find-out-late"></a>What it costs to find out late

A survey costs a day of an engineer's time. Reinforcing a roof after the panels are ordered costs months.

### When the drawings are missing

We measure the beams and calculate again from what is there.`,
};
const articleCtx = article && context({ design, title: article.data.title, address: article.address, trail: trailFor(article.address, article.data.breadcrumb ?? article.data.title), forms: FORMS, email: EMAIL, post: article });
const locals = Astro.locals as { mockupIds?: Record<string, number> };
if (articleCtx) articleCtx.ids = locals.mockupIds ??= {};
