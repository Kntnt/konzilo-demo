{
  "name": "konzilo-demo",
  "private": true,
  "description": "A demonstration website for the fictional company Ampfield Energy, built on Konzilo with a design made in Konzilo Design.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "logos": "konzilo-design logos design/site.design.json",
    "demo-content": "node scripts/demo-content.mjs",
    "predev": "npm run --silent logos && npm run --silent demo-content && konzilo-demo-content",
    "dev": "astro dev",
    "prebuild": "npm run --silent logos && npm run --silent demo-content && konzilo-demo-content",
    "build": "astro build",
    "check": "node scripts/check.mjs",
    "check:seed": "node scripts/check-seed.mjs",
    "shoot": "node scripts/shoot.mjs",
    "image:build": "node image/build.mjs",
    "image:test": "node --test image/tests/",
    "image:check": "node image/checks/visitor.mjs",
    "image:check:arches": "node image/checks/arches.mjs"
  },
  "dependencies": {
    "@kntnt/konzilo": "file:vendor/kntnt-konzilo-0.5.0.tgz",
    "@kntnt/konzilo-design": "file:vendor/kntnt-konzilo-design-0.12.0.tgz",
    "astro": "7.4.2"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "puppeteer-core": "25.16.0"
  }
}
